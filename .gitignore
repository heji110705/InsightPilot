# 本地运行配置，含 API Key —— 永远不要提交
.env
.env.local
.env.*.local
# 但示例文件要提交，否则别人 clone 下来不知道要配哪些变量
!.env.example

# 运行时产物
data/runtime.sqlite
.pytest_cache/
__pycache__/
*.pyc
_work/

# 评测临时输出
/tmp/

# 评测产物：每次 run 都入库会把仓库变成数据仓库。只留 baseline ——
# CI 门禁拿它当锚点，且**只许人工更新**（自动覆盖等于让门禁自己校准成永远绿）。
eval_runs/*
!eval_runs/baseline.json
