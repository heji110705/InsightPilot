# InsightPilot 环境变量示例
#
# 复制成 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。
#
# 不配任何变量也能跑：默认 mode=stub，走规则 + 指标模板的基线路径，
# 界面、SSE、trace、评测全部可用。只有想看模型模式的实际效果才需要填 Key。

# ---------------------------------------------------------------------------
# 推理模式：stub = 规则基线（不联网、不花钱）；api = 调 OpenAI 兼容端点
# ---------------------------------------------------------------------------
IP_LLM_MODE=stub

# ---------------------------------------------------------------------------
# 模型接入（任何 OpenAI 兼容端点都行：DeepSeek / 通义 / Moonshot / 本地 vLLM）
# ---------------------------------------------------------------------------
IP_LLM_BASE_URL=https://api.deepseek.com/v1
IP_LLM_API_KEY=
IP_LLM_MODEL=deepseek-chat
# 采样式任务要可复现，温度固定 0；改大只会让同一题两次跑出不同 SQL。
IP_LLM_TEMPERATURE=0
IP_LLM_TIMEOUT_S=60
IP_LLM_MAX_TOKENS=1200

# ---------------------------------------------------------------------------
# 数据与语义层（相对路径即可，默认指向仓库内的 data/）
# ---------------------------------------------------------------------------
IP_DB_PATH=data/warehouse.sqlite
IP_SEMANTIC_DIR=data/semantic

# ---------------------------------------------------------------------------
# 安全边界：这三项是 SQL 沙箱的硬上限，不建议调大
# ---------------------------------------------------------------------------
IP_ROW_LIMIT=2000
IP_QUERY_TIMEOUT_MS=3000
IP_MAX_RETRIES=3
IP_MAX_CRITIQUES=2
IP_MAX_STEPS=24

# ---------------------------------------------------------------------------
# 上下文预算与观测
# ---------------------------------------------------------------------------
IP_CONTEXT_TOKEN_BUDGET=2600
IP_STATE_DB=data/runtime.sqlite
IP_TRACE=true
IP_CACHE=true
